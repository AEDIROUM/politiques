#position(
  "29",
  [
    #smallcaps[Que l'AÉDIROUM] demande un cessez-le-feu immédiat et le retrait des troupes armées israéliennes en Palestine.
  ],
  adoptée: "AG-2024-11-13",
)

#position(
  "30",
